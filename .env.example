# Public site URL - used for metadataBase, canonical URLs, sitemap, robots, and OG tags.
# Set this to the production domain in Vercel / your host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: base URL for the backend API consumed by src/services/api-client.ts
NEXT_PUBLIC_API_URL=

# SMTP credentials for the booking form route (src/app/api/booking/route.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Inbox that receives booking requests.
BOOKING_TO_EMAIL=
# Inbox that receives driver applications; falls back to BOOKING_TO_EMAIL when empty.
DRIVER_TO_EMAIL=
# Inbox that receives contact-support enquiries; falls back to BOOKING_TO_EMAIL when empty.
CONTACT_TO_EMAIL=
# Inbox that receives newsletter subscriptions; falls back to BOOKING_TO_EMAIL when empty.
NEWSLETTER_TO_EMAIL=
